table Locations
	lineageTag: fb165663-9c5a-4418-989b-52281dfe404e

	measure 'Total Business Exposure' = SUM(Locations[asset_value_usd])
		formatString: "$"#,0
		lineageTag: 28b41c27-229c-4941-af30-9165a407ed3b

	measure 'Avg Risk Score' = AVERAGE(Locations[latest_risk_score])
		formatString: 0.0
		lineageTag: dc04a02d-926c-416b-bcfa-353e97c5df08

	measure 'High Risk Location Count' = COUNTROWS(FILTER(Locations, Locations[latest_risk_score] >= 60))
		formatString: 0
		lineageTag: 9c468100-3b5c-41a7-8d3d-b7ffa7c40015


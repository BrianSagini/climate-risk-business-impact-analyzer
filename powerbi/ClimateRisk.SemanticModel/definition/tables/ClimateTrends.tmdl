table ClimateTrends
	lineageTag: 76f1e208-f1c7-49ee-9df3-86bfc98cd3a8

	column location_id
		dataType: string
		lineageTag: ec283ac2-cbb7-431a-abbe-7f5610424df0
		summarizeBy: none
		sourceColumn: location_id

		annotation SummarizationSetBy = Automatic

	column month
		dataType: dateTime
		lineageTag: bcbba41b-3b06-4f0b-8aae-0350a69fa013
		summarizeBy: none
		formatString: yyyy-MM
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column avg_temp_max_c
		dataType: double
		lineageTag: f5071035-2fe3-4eef-955f-f53540a8e8e3
		summarizeBy: none
		formatString: 0.0
		sourceColumn: avg_temp_max_c

		annotation SummarizationSetBy = Automatic

	column avg_temp_min_c
		dataType: double
		lineageTag: 9579c3b1-b494-4a1a-9a64-ed7710f95da4
		summarizeBy: none
		formatString: 0.0
		sourceColumn: avg_temp_min_c

		annotation SummarizationSetBy = Automatic

	column total_precipitation_mm
		dataType: double
		lineageTag: 585e5767-4899-4856-8263-3b42a30dccec
		summarizeBy: none
		formatString: 0.0
		sourceColumn: total_precipitation_mm

		annotation SummarizationSetBy = Automatic

	column max_windspeed_kmh
		dataType: double
		lineageTag: 0da7af78-ceb2-4f55-9718-4e6db98a6adf
		summarizeBy: none
		formatString: 0.0
		sourceColumn: max_windspeed_kmh

		annotation SummarizationSetBy = Automatic

	measure 'Avg Temp Max (C)' = AVERAGE(ClimateTrends[avg_temp_max_c])
		formatString: 0.0
		lineageTag: a1b1c73f-93d0-4af7-af85-c517764fa35f

	measure 'Avg Temp Min (C)' = AVERAGE(ClimateTrends[avg_temp_min_c])
		formatString: 0.0
		lineageTag: d579576b-18e7-4209-bd3c-82869d591db3

	measure 'Total Precipitation (mm)' = SUM(ClimateTrends[total_precipitation_mm])
		formatString: 0.0
		lineageTag: 807dce68-de1c-4756-afa6-5b7de6893c18

	measure 'Avg Wind Speed (km/h)' = AVERAGE(ClimateTrends[max_windspeed_kmh])
		formatString: 0.0
		lineageTag: a3b7e90b-a39c-4ae5-95cd-91c442e69c2c

	partition ClimateTrends = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database("localhost:5433", "analytics"),
					climate_risk_powerbi_trends = Source{[Schema="climate_risk",Item="powerbi_trends"]}[Data]
				in
					climate_risk_powerbi_trends

	annotation PBI_ResultType = Table
